/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    color: #24352d;
    background: #faf8f3;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

.container {
    width: min(1180px, 90%);
    margin: auto;
}


/* =========================
   NAVBAR
========================= */

.header {
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    background: rgba(250, 248, 243, 0.9);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid rgba(36, 53, 45, 0.08);
}

.navbar {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 700;
    font-family: "Playfair Display", serif;
}

.logo > span:last-child > span {
    color: #b68b45;
}

.logo-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #e8d8bd;
    font-size: 21px;
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #b68b45;
}

.nav-button {
    padding: 12px 21px;
    border-radius: 30px;
    background: #24352d;
    color: white;
    font-size: 14px;
    transition: 0.3s;
}

.nav-button:hover {
    transform: translateY(-3px);
    background: #b68b45;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 24px;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 100vh;
    padding-top: 120px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.badge,
.eyebrow {
    color: #b68b45;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}

.badge {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 9px 15px;
    border-radius: 30px;
    background: #efe7d9;
    margin-bottom: 20px;
}

.hero h1 {
    max-width: 650px;
    font-family: "Playfair Display", serif;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.04;
    margin-bottom: 25px;
}

.hero h1 span,
.section-heading h2 span,
.about-text h2 span,
.appointment-info h2 span {
    color: #b68b45;
}

.hero-text > p {
    max-width: 570px;
    color: #69766f;
    font-size: 17px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 23px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 700;
    transition: 0.3s ease;
}

.primary-btn {
    background: #24352d;
    color: white;
}

.primary-btn:hover {
    background: #b68b45;
    transform: translateY(-4px);
}

.secondary-btn {
    border: 1px solid #d6d0c4;
}

.secondary-btn:hover {
    background: #efe7d9;
    transform: translateY(-4px);
}

.hero-stats {
    display: flex;
    gap: 45px;
    margin-top: 45px;
}

.hero-stats div {
    display: flex;
    flex-direction: column;
}

.hero-stats strong {
    font-family: "Playfair Display", serif;
    font-size: 27px;
}

.hero-stats span {
    color: #7a847e;
    font-size: 12px;
}

.hero-image {
    position: relative;
    min-height: 560px;
    display: grid;
    place-items: center;
}

.image-circle {
    width: 440px;
    height: 440px;
    border-radius: 50%;
    background: #e8d8bd;
    position: absolute;
}

.hero-pet {
    position: relative;
    z-index: 2;
    font-size: 220px;
    filter: drop-shadow(0 25px 20px rgba(0, 0, 0, 0.15));
    animation: floatPet 4s ease-in-out infinite;
}

@keyframes floatPet {
    0%, 100% {
        transform: translateY(0) rotate(-2deg);
    }

    50% {
        transform: translateY(-15px) rotate(2deg);
    }
}

.pet-card {
    position: absolute;
    z-index: 4;
    top: 100px;
    left: 0;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 15px 20px;
    border-radius: 18px;
    background: white;
    box-shadow: 0 20px 50px rgba(40, 45, 40, 0.12);
}

.pet-icon {
    font-size: 28px;
}

.pet-card strong,
.pet-card small {
    display: block;
}

.pet-card small {
    color: #7c857f;
    font-size: 11px;
}

.floating-card {
    position: absolute;
    right: 0;
    bottom: 100px;
    z-index: 4;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 15px 20px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(40, 45, 40, 0.12);
}

.floating-card > i {
    color: #c96d69;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card small {
    color: #7c857f;
    font-size: 11px;
}


/* =========================
   SHAPES
========================= */

.hero-shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.35;
}

.shape-one {
    width: 200px;
    height: 200px;
    background: #e5c9a2;
    top: 120px;
    left: -100px;
}

.shape-two {
    width: 150px;
    height: 150px;
    background: #ccd9c9;
    bottom: 50px;
    right: -70px;
}


/* =========================
   SECTIONS
========================= */

.section {
    padding: 110px 0;
}

.services {
    background: white;
}

.section-heading {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 55px;
}

.section-heading h2 {
    font-family: "Playfair Display", serif;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.1;
    margin: 12px 0 17px;
}

.section-heading p {
    color: #737d77;
}


/* =========================
   SERVICES
========================= */

.service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.service-card {
    padding: 32px 25px;
    background: #faf8f3;
    border: 1px solid #eee9df;
    border-radius: 24px;
    transition: 0.35s;
}

.service-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 50px rgba(36, 53, 45, 0.1);
    border-color: #d6c09c;
}

.service-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    color: #b68b45;
    background: #efe7d9;
    font-size: 22px;
    margin-bottom: 25px;
}

.service-card h3 {
    font-family: "Playfair Display", serif;
    font-size: 22px;
    margin-bottom: 12px;
}

.service-card p {
    color: #737d77;
    font-size: 14px;
    margin-bottom: 20px;
}

.service-card a {
    color: #b68b45;
    font-size: 13px;
    font-weight: 700;
}


/* =========================
   ABOUT
========================= */

.about {
    background: #f0eee7;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: center;
}

.about-visual {
    position: relative;
    min-height: 510px;
}

.about-main-card {
    width: 80%;
    height: 460px;
    border-radius: 35px;
    background: #d7c8ad;
    display: grid;
    place-items: center;
}

.about-pet {
    font-size: 180px;
    filter: drop-shadow(0 25px 20px rgba(0, 0, 0, 0.15));
}

.experience-card {
    position: absolute;
    right: 0;
    bottom: 40px;
